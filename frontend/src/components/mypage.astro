---

---

<div class="container">
    <main id="app" class="app">
        <!-- SCENE 1: PUZZLE -->
        <section
            id="puzzleScene"
            class="scene scene-puzzle active"
            aria-labelledby="puzzleTitle"
        >
            <div class="decor decor-a">✦</div>
            <div class="decor decor-b">♡</div>
            <div class="decor decor-c">✿</div>

            <div class="card puzzle-card">
                <div class="eyebrow">A little secret ♡</div>
                <h1 id="puzzleTitle">Unlock the surprise</h1>
                <p class="subtitle">
                    Selesaikan soal untuk membuka kejutan
                </p>

                <div class="progress" aria-label="Progress">
                    <span class="progress-dot active"></span>
                    <span class="progress-line"></span>
                    <span class="progress-dot"></span>
                    <span class="progress-line"></span>
                    <span class="progress-dot"></span>
                </div>

                <div class="question-box">
                    <span class="question-label"
                        >Question <span id="questionNumber">1</span> of 3</span
                    >
                    <div id="questionText" class="question">—</div>
                </div>

                <div id="feedback" class="feedback" aria-live="polite"></div>

                <div class="keypad" aria-label="Number keypad">
                    <button class="key" data-key="1">1</button>
                    <button class="key" data-key="2">2</button>
                    <button class="key" data-key="3">3</button>

                    <button class="key" data-key="4">4</button>
                    <button class="key" data-key="5">5</button>
                    <button class="key" data-key="6">6</button>

                    <button class="key" data-key="7">7</button>
                    <button class="key" data-key="8">8</button>
                    <button class="key" data-key="9">9</button>

                    <button class="key key-zero" data-key="0">0</button>
                </div>
            </div>
        </section>

        <!-- SCENE 2: GIFT -->
        <section
            id="giftScene"
            class="scene scene-gift"
            aria-labelledby="giftTitle"
            aria-hidden="true"
        >
            <div class="gift-glow"></div>
            <div class="sparkles" aria-hidden="true">
                <span>✦</span><span>✧</span><span>♡</span><span>✦</span><span
                    >✿</span
                >
            </div>

            <div class="gift-content">
                <div class="eyebrow">You unlocked it! ♡</div>
                <h2 id="giftTitle">There is a little surprise for you</h2>
                <p id="giftInstruction">Tap 3 kali di bagian kadonya</p>

                <button
                    id="giftButton"
                    class="gift-button"
                    aria-label="Buka kado"
                >
                    <span class="gift-lid"></span>
                    <span class="gift-box"></span>
                    <span class="gift-ribbon ribbon-v"></span>
                    <span class="gift-ribbon ribbon-h"></span>
                    <span class="gift-bow left"></span>
                    <span class="gift-bow right"></span>
                    <span class="gift-tap-count" id="giftTapCount">0 / 3</span>
                </button>
            </div>

            <div id="flowerLayer" class="flower-layer" aria-hidden="true"></div>
        </section>

        <!-- SCENE 3: GREETING -->
        <section
            id="greetingScene"
            class="scene scene-greeting"
            aria-labelledby="greetingTitle"
            aria-hidden="true"
        >
            <div class="fallen-flowers" aria-hidden="true">
                <span>🌸</span><span>🌼</span><span>🌷</span><span>✿</span><span
                    >🌸</span
                >
            </div>

            <div class="greeting-wrap">
                <div class="greeting-copy">
                    <div class="eyebrow">A message just for you ♡</div>
                    <h2 id="greetingTitle">Hallo Manusia Cantik!</h2>
                    <p>
                        Semoga banyak hal hal baik di hari ini yaa, hal-hal
                        kecil yang bikin kamu bahagia. Jangan lupa istirahat dan
                        jangan terlalu keras sama diri sendiri yaa. Semoga kamu
                        selalu dikelilingi sama orang-orang baik. Semoga besok,
                        lusa dan seterusnya selalu dipertemukan dengan hal hal
                        baik lain nya yaa. Have a nice day manusia cantik! 🌷✨
                    </p>
                    <p class="signature">With lots of love, ♡</p>
                </div>

                <div class="memory-section">
                    <div class="polaroid" id="polaroid">
                        <div class="photo-frame">
                            <div
                                id="photoPlaceholder"
                                class="photo-placeholder"
                            >
                                <span>📸</span>
                                <small>Your photo here</small>
                            </div>
                            <img
                                id="polaroidImage"
                                alt="Foto di dalam polaroid"
                            />
                        </div>
                        <div class="polaroid-caption">A special moment ♡</div>
                    </div>

                    <div class="photo-actions">
                        <button id="cameraBtn" class="primary-btn"
                            >📷 Take a Photo</button
                        >
                        <label class="secondary-btn">
                            🖼️ Choose from Gallery
                            <input
                                id="galleryInput"
                                type="file"
                                accept="image/*"
                            />
                        </label>
                        <button
                            id="resetPhotoBtn"
                            class="text-btn"
                            type="button">Use default photo</button
                        >
                    </div>

                    <p id="photoStatus" class="photo-status" aria-live="polite">
                    </p>
                </div>
            </div>
            <!-- MESSAGE TO CREATOR -->
            <div class="message-section">
                <div class="message-header">
                    <span class="message-icon">💌</span>
                    <div>
                        <div class="eyebrow">A little message ♡</div>
                        <h3>Leave a message</h3>
                    </div>
                </div>

                <p class="message-intro">
                    Kirim pesan untuk melihat bunga✨
                </p>

                <form class="message-form" name="message cute">
                    <div class="message-field">
                        <label for="senderName">Nama kamu</label>
                        <input
                            type="text"
                            id="senderName"
                            name="name"
                            placeholder="Tulis nama kamu..."
                            maxlength="50"
                            autocomplete="name"
                        />
                    </div>

                    <div class="message-field">
                        <label for="senderMessage">Pesan kamu</label>
                        <textarea
                            id="senderMessage"
                            name="message"
                            placeholder="Tulis pesan untuk pembuat..."
                            maxlength="500"
                            rows="5"></textarea>

                        <div class="message-counter">
                            <span id="messageCounter">0</span>/500
                        </div>
                    </div>

                    <button
                        id="sendMessageBtn"
                        class="primary-btn send-message-btn"
                        type="button"
                    >
                        💌 Send Message
                    </button>
                </form>
            </div>
        </section>

        <!-- CAMERA MODAL -->
        <div id="cameraModal" class="modal" aria-hidden="true">
            <div class="modal-backdrop" data-close-camera></div>
            <div
                class="camera-dialog"
                role="dialog"
                aria-modal="true"
                aria-labelledby="cameraTitle"
            >
                <div class="modal-header">
                    <div>
                        <div class="eyebrow">Make a memory ♡</div>
                        <h3 id="cameraTitle">Take your photo</h3>
                    </div>
                    <button
                        id="closeCameraBtn"
                        class="close-btn"
                        aria-label="Tutup">×</button
                    >
                </div>

                <div class="camera-stage">
                    <video id="cameraVideo" autoplay playsinline muted></video>
                    <canvas id="cameraCanvas" hidden></canvas>
                    <div id="cameraError" class="camera-error" hidden></div>
                </div>

                <div class="camera-controls">
                    <button
                        id="captureBtn"
                        class="capture-btn"
                        type="button"
                        aria-label="Ambil foto"></button>
                </div>
            </div>
        </div>

        <!-- PHOTO PREVIEW MODAL -->
        <div id="previewModal" class="modal" aria-hidden="true">
            <div class="modal-backdrop"></div>
            <div
                class="preview-dialog"
                role="dialog"
                aria-modal="true"
                aria-labelledby="previewTitle"
            >
                <div class="modal-header">
                    <div>
                        <div class="eyebrow">Looks cute! ♡</div>
                        <h3 id="previewTitle">Use this photo?</h3>
                    </div>
                </div>
                <div class="preview-frame">
                    <img id="previewImage" alt="Preview foto" />
                </div>
                <div class="preview-actions">
                    <button id="retakeBtn" class="secondary-btn" type="button"
                        >Retake</button
                    >
                    <button id="usePhotoBtn" class="primary-btn" type="button"
                        >Use Photo ♡</button
                    >
                </div>
            </div>
        </div>

        <!-- MESSAGE POPUP -->
        <div id="messagePopup" class="message-popup" aria-hidden="true">
            <div class="message-popup-backdrop"></div>

            <div
                class="message-popup-card"
                role="dialog"
                aria-modal="true"
                aria-live="polite"
            >
                <div id="messagePopupIcon" class="message-popup-icon">💌</div>

                <h3 id="messagePopupTitle">Pesan terkirim!</h3>

                <p id="messagePopupText">Terima kasih sudah mengirim pesan ♡</p>
            </div>
        </div>
    </main>

</div>

<script>
    import "../js/app.js";
</script>


<style>
    @import url("https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700;800&display=swap");

    :root {
        --primary: #e85d8e;
        --primary-light: #f8bbd0;
        --secondary: #cdb4db;
        --accent: #ffe5a5;
        --success: #b8e0d2;
        --background: #fff8f0;
        --surface: #ffffff;
        --text: #403a3e;
        --muted: #81757b;
        --shadow: 0 18px 45px rgba(64, 58, 62, 0.12);
        --soft-shadow: 0 8px 22px rgba(64, 58, 62, 0.1);
        --radius: 16px;
    }

    * {
        box-sizing: border-box;
    }

    .hide {
        display: none;
        z-index: -1;
    }

    /* .photo-frame .kanjut {
  z-index: 99;
} */

    .container {
        margin: 0;
        min-height: 100%;
        font-family: "Nunito", system-ui, sans-serif;
        color: var(--text);
        background: var(--background);
    }

    .container {
        min-height: 100vh;
        overflow-x: hidden;
    }

    button,
    input {
        font: inherit;
    }

    button,
    label {
        -webkit-tap-highlight-color: transparent;
    }

    button {
        cursor: pointer;
    }

    .app {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
    }

    .scene {
        min-height: 100vh;
        width: 100%;
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 24px;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(18px) scale(0.985);
        transition:
            opacity 0.65s ease,
            transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1),
            visibility 0.65s;
    }

    .scene.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0) scale(1);
    }

    .scene-puzzle {
        background:
            radial-gradient(
                circle at 12% 18%,
                rgba(248, 187, 208, 0.55),
                transparent 22%
            ),
            radial-gradient(
                circle at 88% 82%,
                rgba(205, 180, 219, 0.42),
                transparent 25%
            ),
            var(--background);
    }

    .card {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.85);
        box-shadow: var(--shadow);
        backdrop-filter: blur(10px);
    }

    .puzzle-card {
        width: min(440px, 100%);
        border-radius: var(--radius);
        padding: 34px 28px 26px;
        text-align: center;
        position: relative;
        z-index: 2;
    }

    .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.13em;
        font-size: 0.72rem;
        font-weight: 800;
        color: var(--primary);
    }

    h1,
    h2,
    h3 {
        font-family: "Baloo 2", cursive;
        line-height: 0.98;
        margin: 8px 0;
    }

    h1 {
        font-size: clamp(2.25rem, 8vw, 3.2rem);
    }

    h2 {
        font-size: clamp(2rem, 7vw, 3.2rem);
    }

    h3 {
        font-size: 1.8rem;
    }

    .subtitle {
        color: var(--muted);
        margin: 10px auto 22px;
        max-width: 330px;
    }

    .progress {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin: 12px 0 20px;
    }

    .progress-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--primary-light);
        transition: 0.3s ease;
    }

    .progress-dot.active {
        width: 13px;
        height: 13px;
        background: var(--primary);
        box-shadow: 0 0 0 5px rgba(232, 93, 142, 0.12);
    }

    .progress-dot.done {
        background: var(--success);
    }

    .progress-line {
        width: 26px;
        height: 3px;
        border-radius: 999px;
        background: var(--primary-light);
    }

    .question-box {
        background: var(--background);
        border-radius: 22px;
        padding: 10px;
        margin-bottom: 10px;
    }

    .question-label {
        font-size: 0.76rem;
        color: var(--muted);
        font-weight: 800;
    }

    .question {
        font-family: "Baloo 2", cursive;
        font-size: 2.35rem;
        font-weight: 700;
        margin-top: 2px;
    }

    .answer-display {
        min-height: 28px;
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--primary);
    }

    .feedback {
        min-height: 26px;
        font-size: 0.88rem;
        font-weight: 800;
    }

    .feedback.success {
        color: #4d9a83;
    }

    .feedback.error {
        color: var(--primary);
    }

    .keypad {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 6px;
    }

    .key {
        border: 0;
        min-height: 45px;
        border-radius: 17px;
        background: var(--primary-light);
        color: var(--text);
        font-weight: 800;
        font-size: 1.15rem;
        box-shadow: 0 5px 0 rgba(232, 93, 142, 0.16);
        transition:
            transform 0.12s ease,
            background 0.18s ease,
            box-shadow 0.12s ease;
    }

    .key-zero {
        grid-column: 2;
    }

    .key:hover {
        background: #f3a9c2;
    }

    .key:active {
        transform: translateY(4px) scale(0.97);
        box-shadow: 0 1px 0 rgba(232, 93, 142, 0.16);
    }

    .key-action {
        background: var(--secondary);
    }

    .key-submit {
        background: var(--primary);
        color: white;
        box-shadow: 0 5px 0 rgba(183, 63, 105, 0.3);
    }

    .key-submit:hover {
        background: #d94d7f;
    }

    .hint {
        color: var(--muted);
        font-size: 0.76rem;
        margin: 18px 0 0;
    }

    .keypad.shake {
        animation: keypadShake 0.38s ease;
    }

    @keyframes keypadShake {
        0%,
        100% {
            transform: translateX(0);
        }

        20% {
            transform: translateX(-8px);
        }

        40% {
            transform: translateX(8px);
        }

        60% {
            transform: translateX(-5px);
        }

        80% {
            transform: translateX(5px);
        }
    }

    .key.wrong-answer {
        animation: wrongAnswer 0.4s ease;
    }

    @keyframes wrongAnswer {
        0% {
            transform: scale(1);
        }

        30% {
            transform: scale(0.9);
            background: #e85d8e;
            color: white;
        }

        60% {
            transform: scale(1.08);
        }

        100% {
            transform: scale(1);
        }
    }

    .decor {
        position: absolute;
        z-index: 1;
        font-size: clamp(2rem, 7vw, 4.5rem);
        opacity: 0.6;
        animation: float 5s ease-in-out infinite;
    }

    .decor-a {
        top: 10%;
        left: 9%;
        color: var(--accent);
    }

    .decor-b {
        top: 17%;
        right: 10%;
        color: var(--primary);
        animation-delay: -1.2s;
    }

    .decor-c {
        bottom: 10%;
        left: 12%;
        color: var(--secondary);
        animation-delay: -2s;
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0) rotate(-4deg);
        }

        50% {
            transform: translateY(-14px) rotate(5deg);
        }
    }

    .scene-gift {
        background:
            radial-gradient(
                circle at 50% 50%,
                rgba(248, 187, 208, 0.28),
                transparent 35%
            ),
            var(--background);
    }

    .gift-content {
        text-align: center;
        position: relative;
        z-index: 4;
        margin-top: -35px;
    }

    .gift-content h2 {
        max-width: 560px;
        margin-inline: auto;
    }

    .gift-content p {
        color: var(--muted);
        margin-bottom: 26px;
    }

    .gift-button {
        width: 230px;
        height: 230px;
        border: 0;
        background: transparent;
        position: relative;
        display: block;
        margin: 0 auto;
        filter: drop-shadow(0 22px 25px rgba(64, 58, 62, 0.12));
        transition: transform 0.2s ease;
    }

    .gift-button:hover {
        transform: translateY(-4px);
    }
    .gift-button:focus-visible {
        outline: 4px solid rgba(232, 93, 142, 0.25);
        border-radius: 30px;
    }

    .gift-box {
        position: absolute;
        width: 132px;
        height: 104px;
        left: 49px;
        top: 82px;
        background: var(--primary-light);
        border-radius: 10px 10px 18px 18px;
        box-shadow: inset -8px -9px 0 rgba(205, 180, 219, 0.35);
    }

    .gift-lid {
        position: absolute;
        width: 154px;
        height: 35px;
        left: 38px;
        top: 65px;
        border-radius: 9px;
        background: var(--primary);
        box-shadow: inset -8px -5px 0 rgba(183, 63, 105, 0.14);
        z-index: 3;
    }

    .gift-ribbon {
        position: absolute;
        background: var(--accent);
        z-index: 4;
    }

    .ribbon-v {
        width: 23px;
        height: 139px;
        left: 104px;
        top: 62px;
    }

    .ribbon-h {
        width: 146px;
        height: 18px;
        left: 42px;
        top: 91px;
    }

    .gift-bow {
        position: absolute;
        width: 54px;
        height: 34px;
        top: 38px;
        background: var(--accent);
        z-index: 2;
        border-radius: 80% 20% 80% 20%;
    }

    .gift-bow.left {
        left: 66px;
        transform: rotate(22deg);
    }
    .gift-bow.right {
        right: 66px;
        transform: scaleX(-1) rotate(22deg);
    }

    .gift-tap-count {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 6px;
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 800;
        z-index: 7;
    }

    .gift-button.tap-one {
        animation: giftTapOne 0.45s ease;
    }
    .gift-button.tap-two {
        animation: giftTapTwo 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .gift-button.explode {
        animation: giftExplode 0.5s ease forwards;
    }

    @keyframes giftTapOne {
        35% {
            transform: scale(1.12) rotate(-2deg);
        }
        65% {
            transform: scale(0.98) rotate(2deg);
        }
    }
    @keyframes giftTapTwo {
        20% {
            transform: scale(1.16) rotate(3deg);
        }
        45% {
            transform: scale(0.95) rotate(-4deg);
        }
        70% {
            transform: scale(1.08) rotate(2deg);
        }
    }
    @keyframes giftExplode {
        40% {
            transform: scale(1.2) rotate(-3deg);
        }
        100% {
            transform: scale(0.15) rotate(15deg);
            opacity: 0;
        }
    }

    .sparkles span {
        position: absolute;
        z-index: 2;
        font-size: 2rem;
        animation: sparkleFloat 3.5s ease-in-out infinite;
    }
    .sparkles span:nth-child(1) {
        top: 18%;
        left: 17%;
        color: var(--accent);
    }
    .sparkles span:nth-child(2) {
        top: 30%;
        right: 17%;
        color: var(--secondary);
        animation-delay: -0.7s;
    }
    .sparkles span:nth-child(3) {
        bottom: 22%;
        left: 21%;
        color: var(--primary);
        animation-delay: -1.3s;
    }
    .sparkles span:nth-child(4) {
        bottom: 17%;
        right: 20%;
        color: var(--accent);
        animation-delay: -2s;
    }
    .sparkles span:nth-child(5) {
        top: 20%;
        left: 47%;
        color: var(--secondary);
        animation-delay: -2.5s;
    }

    @keyframes sparkleFloat {
        50% {
            transform: translateY(-12px) scale(1.12) rotate(12deg);
        }
    }

    .flower-layer {
        position: absolute;
        inset: 0;
        z-index: 20;
        pointer-events: none;
        overflow: hidden;
    }

    .flower {
        position: absolute;
        left: 50%;
        top: 50%;
        font-size: var(--size);
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.2) rotate(0);
        animation: flowerBurst var(--duration) cubic-bezier(0.12, 0.72, 0.25, 1)
            forwards;
        animation-delay: var(--delay);
    }

    @keyframes flowerBurst {
        0% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.15) rotate(0);
        }
        12% {
            opacity: 1;
        }
        100% {
            opacity: 1;
            transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y)))
                scale(1) rotate(var(--rotate));
        }
    }

    .flower.fall {
        animation: flowerFall 1.15s cubic-bezier(0.4, 0, 0.7, 1) forwards;
    }

    @keyframes flowerFall {
        to {
            transform: translate(var(--x), calc(100vh + 80px))
                rotate(calc(var(--rotate) + 360deg));
            opacity: 0.15;
        }
    }

    /* GREETING */
    .scene-greeting {
        align-items: start;
        overflow-y: auto;
        padding: 70px 24px 80px;
        background:
            radial-gradient(
                circle at 10% 15%,
                rgba(248, 187, 208, 0.34),
                transparent 20%
            ),
            radial-gradient(
                circle at 90% 75%,
                rgba(205, 180, 219, 0.3),
                transparent 25%
            ),
            var(--background);
    }

    .greeting-wrap {
        width: min(980px, 100%);
        display: grid;
        grid-template-columns: 1fr 0.85fr;
        gap: 50px;
        align-items: center;
